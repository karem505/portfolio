# Supabase Configuration (for blog)
# Get from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ISR Revalidation Secret
# Used by the blog agent to trigger cache revalidation
# Generate a random string: openssl rand -hex 32
REVALIDATE_SECRET=your_secret_here

# Optional: Service key for server-side operations
# Only needed if you want to bypass RLS for admin operations
SUPABASE_SERVICE_KEY=your_service_role_key_here
